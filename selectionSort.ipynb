      "source": [
        "def selectionSort(arr):\n",
        "  n=len(arr)\n",
        "\n",
        "  for i in range(n):\n",
        "    minIdx=i\n",
        "\n",
        "    for j in range(i+1,n):\n",
        "      if arr[j]<arr[minIdx]:\n",
        "        minIdx=j\n",
        "\n",
        "    arr[i],arr[minIdx]=arr[minIdx],arr[i]\n",
        "  return arr"
      ]
    },
    {
      "cell_type": "code",
      "source": [
        "arr=[12,2,45,7,67,56,89,76]\n",
        "selectionSort(arr)"
      ],
